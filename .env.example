# VERCEL - Set to the real https://.../graphql URL, never a loopback URL in production.
WORDPRESS_GRAPHQL_URL=
# Base64 of WordPress username:application-password (Basic Auth). Despite the legacy name, NOT an OAuth refresh token.
# Required only server-side for preview; generate with: printf '%s' 'username:application password' | base64 | tr -d '\n'
WORDPRESS_AUTH_REFRESH_TOKEN=
# Generate independent high-entropy secrets; never expose with NEXT_PUBLIC_.
WORDPRESS_WEBHOOK_SECRET=
WORDPRESS_PREVIEW_SECRET=
# Canonical public origin without trailing slash; e.g. your verified production Vercel domain.
NEXT_PUBLIC_SITE_URL=
# Media account cloud name, visible to visitors.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# WordPress ONLY: cloudinary://API_KEY:API_SECRET@CLOUD_NAME; do not add to Vercel project.
CLOUDINARY_URL=
# WordPress ONLY: webhook destination; set to https://<verified frontend domain>/api/revalidate
VERCEL_REVALIDATE_URL=
# WordPress ONLY: the canonical frontend origin; same value as NEXT_PUBLIC_SITE_URL
FRONTEND_ORIGIN_URL=
# WordPress ONLY: set via wp-config.php from WORDPRESS_WEBHOOK_SECRET and WORDPRESS_PREVIEW_SECRET
VERCEL_WEBHOOK_SECRET=
VERCEL_PREVIEW_SECRET=
